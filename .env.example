# Training Data Generator Environment Variables
# Copy to .env and fill in actual values

# Database (PostgreSQL)
TRAINING_DATA_GEN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/training_data_generator

# Service metadata
TRAINING_DATA_GEN_SERVICE_NAME=training-data-generator
TRAINING_DATA_GEN_PORT=8152
TRAINING_DATA_GEN_VERSION=0.1.0
TRAINING_DATA_GEN_ENVIRONMENT=production
TRAINING_DATA_GEN_LOG_LEVEL=INFO
TRAINING_DATA_GEN_LOG_FORMAT=json

# Upstream service URLs
TRAINING_DATA_GEN_DATA_COLLECTOR_URL=http://localhost:8151
TRAINING_DATA_GEN_MODEL_REGISTRY_URL=http://localhost:8155

# MinIO / object storage
TRAINING_DATA_GEN_MINIO_ENDPOINT=localhost:9000
TRAINING_DATA_GEN_MINIO_BUCKET=training-data
TRAINING_DATA_GEN_MINIO_USE_SSL=false

# Secrets (no defaults - must be set)
TRAINING_DATA_GEN_MINIO_ACCESS_KEY=minioadmin
TRAINING_DATA_GEN_MINIO_SECRET_KEY=minioadmin

# Retraining thresholds
TRAINING_DATA_GEN_INITIAL_SAMPLE_THRESHOLD=200
TRAINING_DATA_GEN_SUBSEQUENT_SAMPLE_THRESHOLD=100
TRAINING_DATA_GEN_QUALITY_THRESHOLD=0.80
TRAINING_DATA_GEN_RETRAIN_INTERVAL_DAYS=14

# Training configuration
TRAINING_DATA_GEN_TRAIN_SPLIT=0.9

# Observability
TRAINING_DATA_GEN_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
